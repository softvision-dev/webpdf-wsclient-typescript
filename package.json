{
	"name": "@softvision/webpdf-wsclient-typescript",
	"version": "11.0.0-beta.58",
	"description": "A simplified and optimized API client library for the webPDF server",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"require": "./lib/index.js",
			"import": "./lib/esm/index.js",
			"default": "./lib/index.js"
		}
	},
	"sideEffects": false,
	"author": "SoftVision Development GmbH",
	"license": "Apache-2.0",
	"packageManager": "yarn@4.14.1",
	"homepage": "https://github.com/softvision-dev/webpdf-wsclient-typescript#readme",
	"bugs": {
		"url": "https://github.com/softvision-dev/webpdf-wsclient-typescript/issues"
	},
	"keywords": [
		"typescript",
		"javascript",
		"softvision",
		"api",
		"client",
		"pdf",
		"webservice",
		"rest-api",
		"pdf-converter",
		"pdf-generation",
		"pdf-manipulation",
		"webpdf",
		"webpdf-server",
		"webpdf-wsclient",
		"pdf-portal"
	],
	"scripts": {
		"compile": "tsc -p tsconfig.json",
		"compile:esm": "tsc -p tsconfig.esm.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:tests": "tsc -p src/tests/tsconfig.json --noEmit",
		"clean": "shx rm -rf lib build",
		"codegen:raw": "yarn openapi-generator-cli generate -i src/codegen/resources/schema/openapi.json -g typescript-axios -c src/codegen/resources/openapi-generator-config.json -o build/codegen/raw",
		"codegen": "ts-node --project src/codegen/typescript/tsconfig.json src/codegen/typescript/generate.ts",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"build": "node scripts/build.js",
		"deploy": "node scripts/deploy.js",
		"publish:local": "node scripts/deploy.js --target local",
		"publish:public": "node scripts/deploy.js --target public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softvision-dev/webpdf-wsclient-typescript"
	},
	"dependencies": {
		"axios": "^1.16.0"
	},
	"devDependencies": {
		"@azure/msal-node": "^5.1.5",
		"@eslint/compat": "^2.0.5",
		"@openapitools/openapi-generator-cli": "^2.32.0",
		"@types/adm-zip": "^0.5.8",
		"@types/auth0": "^3.3.11",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^8.59.2",
		"@typescript-eslint/parser": "^8.59.2",
		"adm-zip": "^0.5.17",
		"auth0": "^5.9.1",
		"chai": "^6.2.2",
		"dotenv": "^16.6.1",
		"eslint": "^10.3.0",
		"form-data": "^4.0.5",
		"mocha": "^11.7.5",
		"parcel": "^2.16.4",
		"shx": "^0.4.0",
		"testcontainers": "^11.14.0",
		"tmp": "^0.2.5",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"files": [
		"lib/**/*"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"engines": {
		"node": ">=20"
	}
}
